; Copy this file to ModkitLocal.ini (same folder as DBDMount.uproject) and edit. It is the ONLY file with machine specific absolute paths.
; Forward slashes work on Windows. Never put a key VALUE here, only the PATH of a key file you created yourself.
[Local]
; Profile= is the profile FOLDER: the folder that contains profile.json AND engine.ini. It is NOT the path of profile.json.
;   right: .../Suzie/Profiles/DBD        wrong: .../Suzie/Profiles/DBD/profile.json   (the wrong form makes Suzie idle: "no profile selected")
Profile=D:/DBDModkit/Windows/Engine/Plugins/Modkit/Suzie/Profiles/DBD
; install root of your Dead by Daylight (the folder that contains DeadByDaylight\Content\Paks)
GameRoot=D:/Games/Dead by Daylight
; text file with the game's AES key (one line, 0x + 64 hex digits). You provide it, it is not shipped.
KeyFile=D:/DBDModkit/secrets/dbd-aes.txt
; optional: engine root, used by the sweep harness and helper scripts (default: path from EngineAssociation / MODKIT_ENGINE)
EngineDir=D:/DBDModkit/Windows
; the game's jmap (JSON reflection dump of the game process, trumank/jmap format). You provide it. Suzie generates the game's types and gameplay tags from it at every start.
Jmap=D:/DBDModkit/game-data/DBD-10.2.2.jmap
