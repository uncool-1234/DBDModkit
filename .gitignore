# Allow-list: only the entries below are tracked. The other folders of the layout (README.md) are separate clones, the
# user's game data and key file, logs and local output.
/*
!/.gitignore
!/LICENSE
!/README.md
!/AGENTS.md
!/docs/
!/tools/
!/Profiles/
!/Packaging/
!/DBDMount/
/DBDMount/*
!/DBDMount/DBDMount.uproject
!/DBDMount/Source/

/Profiles/*/Plugin/*/Binaries/
/Profiles/*/Plugin/*/Intermediate/
/Profiles/*/data/golden/
/Profiles/*/sweeps/
__pycache__/
